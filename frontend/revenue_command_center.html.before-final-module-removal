<script>
/* REVENEX_CUSTOMER360_SUMMARY_WIRING */
(function () {
  function money(value) {
    return "₹" + Number(value || 0).toLocaleString("en-IN");
  }

  function updateCustomer360Summary() {
    const table = document.getElementById("customersTable");
    if (!table) return;

    const rows = Array.from(table.querySelectorAll("tr"))
      .filter(row => row.querySelectorAll("td").length >= 4);

    const customers = rows.map(row => {
      const cells = row.querySelectorAll("td");
      return {
        customer: cells[0]?.textContent?.trim() || "",
        exposureText: cells[1]?.textContent?.trim() || "",
        risk: cells[2]?.textContent?.trim()?.toUpperCase() || "",
        priority: cells[3]?.textContent?.trim()?.toUpperCase() || ""
      };
    }).filter(x => x.customer && !/run analysis/i.test(x.customer));

    let exposure = 0;

    customers.forEach(customer => {
      const raw = customer.exposureText
        .replace(/[₹,\s]/g, "")
        .replace(/[^\d.-]/g, "");

      const value = Number(raw);
      if (Number.isFinite(value)) exposure += value;
    });

    const highRisk = customers.filter(x =>
      /HIGH|CRITICAL|REVIEW/.test(x.risk)
    ).length;

    const priority = customers.filter(x =>
      /AI PRIORITY|PRIORITY/.test(x.priority)
    ).length;

    const count = document.getElementById("customer360Count");
    const total = document.getElementById("customer360Exposure");
    const risk = document.getElementById("customer360HighRisk");
    const ai = document.getElementById("customer360Priority");

    if (count) count.textContent = customers.length;
    if (total) total.textContent = money(exposure);
    if (risk) risk.textContent = highRisk;
    if (ai) ai.textContent = priority;
  }

  window.updateCustomer360Summary = updateCustomer360Summary;

  const observer = new MutationObserver(function () {
    updateCustomer360Summary();
  });

  function init() {
    const table = document.getElementById("customersTable");
    if (!table) return;

    observer.observe(table, {
      childList: true,
      subtree: true,
      characterData: true
    });

    updateCustomer360Summary();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
</script>


<script>
/* REVENEX_CUSTOMER360_ROW_GOVERNANCE */
(function () {

  function enhanceCustomerRows() {
    const table = document.getElementById("customersTable");
    if (!table) return;

    const rows = Array.from(table.querySelectorAll("tr"));

    rows.forEach(function (row) {
      const cells = row.querySelectorAll("td");

      /*
       * Existing renderer provides:
       * Customer | Exposure | Risk | Priority
       *
       * We add:
       * Decision | Governance
       */

      if (cells.length < 4) return;

      if (row.dataset.revenexGovernance === "true") return;

      const customer = cells[0].textContent.trim();

      if (!customer || /run analysis/i.test(customer)) return;

      const risk = cells[2].textContent.trim().toUpperCase();

      const decision = document.createElement("td");
      decision.className = "revenex-customer-decision";

      if (/HIGH|CRITICAL|REVIEW/.test(risk)) {
        decision.innerHTML =
          '<strong>RECOVERY REVIEW</strong>';
      } else {
        decision.innerHTML =
          '<span>MONITOR</span>';
      }

      const governance = document.createElement("td");
      governance.className = "revenex-customer-governance";

      governance.innerHTML =
        '<strong>APPROVAL REQUIRED</strong>' +
        '<small>Execution disabled</small>';

      row.appendChild(decision);
      row.appendChild(governance);

      row.dataset.revenexGovernance = "true";
    });
  }

  function initCustomerGovernance() {
    const table = document.getElementById("customersTable");
    if (!table) return;

    enhanceCustomerRows();

    const observer = new MutationObserver(function () {
      enhanceCustomerRows();
    });

    observer.observe(table, {
      childList: true,
      subtree: true,
      characterData: true
    });

    window.revenexEnhanceCustomerRows = enhanceCustomerRows;
  }

  if (document.readyState === "loading") {
    document.addEventListener(
      "DOMContentLoaded",
      initCustomerGovernance
    );
  } else {
    initCustomerGovernance();
  }

})();
</script>





<script>
(function () {

  function money(value) {
    const n = Number(String(value || "")
      .replace(/[₹,\s]/g, "")
      .replace(/[^\d.-]/g, ""));

    return Number.isFinite(n)
      ? "₹" + n.toLocaleString("en-IN")
      : "₹0";
  }

  function openCustomer(row) {

    const cells = row.querySelectorAll("td");

    if (cells.length < 3) return;

    const customer = cells[0].textContent.trim();

    if (!customer || /run analysis/i.test(customer)) {
      return;
    }

    const exposure = cells[1].textContent.trim();
    const risk = cells[2].textContent.trim();
    const priority = cells[3]
      ? cells[3].textContent.trim()
      : "AI PRIORITY";

    const panel = document.getElementById("customer360Detail");

    if (!panel) {
      console.error("[REVENEX] Customer 360 detail panel missing");
      return;
    }

    document.getElementById("c360DetailCustomer").textContent = customer;

    document.getElementById("c360DetailExposure").textContent =
      money(exposure);

    document.getElementById("c360DetailRisk").textContent =
      risk || "REVIEW";

    document.getElementById("c360DetailPriority").textContent =
      priority || "AI PRIORITY";

    document.getElementById("c360DetailDecision").textContent =
      "RECOVERY REVIEW";

    document.getElementById("c360DetailGovernance").textContent =
      "APPROVAL REQUIRED";

    document.getElementById("c360DetailReason").textContent =
      "REVENEX identified this customer as a review priority based on the available revenue exposure and risk signal. The recommendation is advisory-only and requires human approval.";

    panel.style.display = "block";

    panel.scrollIntoView({
      behavior: "smooth",
      block: "nearest"
    });
  }

  function wireCustomerRows() {

    const table = document.getElementById("customersTable");

    if (!table) return;

    table.querySelectorAll("tr").forEach(function (row) {

      const cells = row.querySelectorAll("td");

      if (cells.length < 3) return;

      const customer = cells[0].textContent.trim();

      if (!customer || /run analysis/i.test(customer)) return;

      if (row.dataset.revenexCustomer360 === "true") return;

      row.dataset.revenexCustomer360 = "true";

      row.style.cursor = "pointer";

      row.addEventListener("click", function () {
        openCustomer(row);
      });

    });
  }

  function initCustomer360() {

    const table = document.getElementById("customersTable");

    if (!table) {
      console.warn("[REVENEX] customersTable not ready");
      return;
    }

    wireCustomerRows();

    const observer = new MutationObserver(function () {
      wireCustomerRows();
    });

    observer.observe(table, {
      childList: true,
      subtree: true,
      characterData: true
    });

    console.log("[REVENEX] Customer 360 intelligence ready");
  }

  if (document.readyState === "loading") {
    document.addEventListener(
      "DOMContentLoaded",
      initCustomer360
    );
  } else {
    initCustomer360();
  }

})();
</script>


<script>
/* REVENEX_FINAL_MODULE_REPAIR */
(function () {
  "use strict";

  function money(v) {
    return "₹" + Number(v || 0).toLocaleString("en-IN");
  }

  function set(id, value) {
    const el = document.getElementById(id);
    if (el) el.textContent = value;
  }

  function esc(v) {
    return String(v ?? "")
      .replace(/&/g,"&amp;")
      .replace(/</g,"&lt;")
      .replace(/>/g,"&gt;")
      .replace(/"/g,"&quot;")
      .replace(/'/g,"&#039;");
  }

  function renderModules() {
    const data = window.REVENEX_LAST_DATA;
    const payload = window.REVENEX_LAST_PAYLOAD || {};

    if (!data) return;

    const risk = data.risk || {};
    const decision = data.decision || {};

    /* INVOICES */
    const invoices =
      Array.isArray(payload.invoices) && payload.invoices.length
        ? payload.invoices
        : Array.isArray(data.invoices)
          ? data.invoices
          : [];

    const invoiceTable = document.getElementById("invoiceTable");

    if (invoiceTable) {
      invoiceTable.innerHTML = invoices.length
        ? invoices.map(i => `
          <tr>
            <td>${esc(i.customer_id)}</td>
            <td>${money(i.amount)}</td>
            <td>${money(i.outstanding_amount)}</td>
            <td>${esc(i.days_overdue ?? 0)} days</td>
          </tr>
        `).join("")
        : '<tr><td colspan="4" class="empty">No invoices.</td></tr>';
    }

    /* COLLECTIONS */
    set("collectionExpected", money(decision.expected_collection));
    set("collectionRisk", money(risk.total_revenue_at_risk));
    set(
      "collectionPriority",
      decision.recommended_action || "—"
    );

    /* FORECAST */
    set("fOutstanding", money(risk.total_outstanding));
    set("fRisk", money(risk.total_revenue_at_risk));
    set("fBaseline", money(risk.expected_collection));
    set("fSelected", money(decision.expected_collection));
    set("fRemainingDetail", money(decision.remaining_exposure));

    const confidence =
      Math.round(Number(decision.confidence || 0) * 100);

    set("fConfidenceDetail", confidence + "%");
    set("fScenarioDetail", decision.scenario || "—");
    set(
      "fApproval",
      decision.requires_approval ? "REQUIRED" : "NOT REQUIRED"
    );

    const interpretation = document.getElementById("fInterpretation");

    if (interpretation) {
      interpretation.textContent =
        "REVENEX forecasts " +
        money(decision.expected_collection) +
        " of expected collection under the " +
        (decision.scenario || "selected") +
        " scenario, leaving " +
        money(decision.remaining_exposure) +
        " of remaining exposure. Prediction confidence is " +
        confidence +
        "%. This forecast is advisory-only and does not execute any financial action.";
    }

    /* EXTRA FORECAST / SIMULATION FIELDS */
    set("simulationOutstanding", money(risk.total_outstanding));
    set("simulationRisk", money(risk.total_revenue_at_risk));
    set("simulationExpected", money(decision.expected_collection));
    set("simulationRecovery", money(decision.expected_collection));
    set("simulationRemaining", money(decision.remaining_exposure));
    set("simulationRemainingDetail", money(decision.remaining_exposure));
    set(
      "simulationConfidence",
      confidence + "%"
    );
    set("simulationScenario", decision.scenario || "—");

    /* COLLECTION / DECISION */
    set(
      "decisionAction",
      decision.recommended_action || "—"
    );
    set(
      "decisionConfidence",
      confidence + "%"
    );
    set(
      "decisionApproval",
      decision.requires_approval ? "YES" : "NO"
    );
  }

  /*
   * Capture the successful analysis response.
   * Analyze Revenue already calls updateDashboard(data,payload),
   * so this does not alter the API or decision engine.
   */
  const originalUpdate = window.updateDashboard;

  if (typeof originalUpdate === "function" &&
      !window.__REVENEX_UPDATE_WRAPPED__) {

    window.updateDashboard = function(data, payload) {
      window.REVENEX_LAST_DATA = data;
      window.REVENEX_LAST_PAYLOAD = payload;

      const result = originalUpdate.apply(this, arguments);

      setTimeout(renderModules, 0);
      setTimeout(renderModules, 100);

      return result;
    };

    window.__REVENEX_UPDATE_WRAPPED__ = true;
  }

  /*
   * Repair navigation for the three modules.
   * Works with existing .page sections without replacing
   * the existing dashboard.
   */
  function navigate(name) {
    const pages = document.querySelectorAll(".page");

    pages.forEach(page => {
      page.style.display =
        page.id === name ? "block" : "none";
    });

    document
      .querySelectorAll("[data-page]")
      .forEach(el => {
        el.classList.toggle(
          "active",
          el.getAttribute("data-page") === name
        );
      });

    renderModules();
  }

  window.REVENEXNavigate = navigate;

  document.addEventListener("click", function(e) {
    const item = e.target.closest(
      "[data-page], a, button"
    );

    if (!item) return;

    const text =
      (item.textContent || "").trim().toLowerCase();

    let page = null;

    if (text === "invoices" || text.includes("invoice intelligence")) {
      page = "invoices";
    } else if (
      text === "collections" ||
      text.includes("collections & recovery")
    ) {
      page = "collections";
    } else if (
      text === "forecast" ||
      text.includes("revenue forecast")
    ) {
      page = "forecast";
    }

    if (!page) return;

    const target = document.getElementById(page);

    if (target) {
      e.preventDefault();
      navigate(page);
    }
  }, true);

  function boot() {
    renderModules();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }

})();
</script>




