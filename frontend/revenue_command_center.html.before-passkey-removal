      sessionStorage.removeItem("revenex_authenticated");
      sessionStorage.removeItem("revenex_user");
    } catch (_) {}

    const login = document.getElementById("revenexLogin");
    if (login) {
      login.style.display = "flex";
      login.style.opacity = "1";
      login.style.transform = "scale(1)";
    }

    btn.style.display = "none";
  });

  if (sessionStorage.getItem("revenex_authenticated") !== "true") {
    btn.style.display = "none";
  }
})();
</script>


