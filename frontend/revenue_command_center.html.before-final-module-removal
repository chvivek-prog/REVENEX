}


function renderCustomers360(data){
    const container =
        document.getElementById("customers360") ||
        document.getElementById("customer360") ||
        document.getElementById("customerTable");

    if(!container) return;

    const risks = Array.isArray(data?.customer_risks)
        ? data.customer_risks
        : Array.isArray(data?.risk?.customer_risks)
            ? data.risk.customer_risks
            : [];

    if(!risks.length){
        container.innerHTML =
            '<div class="empty">Run analysis to populate Customers 360.</div>';
        return;
    }

    container.innerHTML = `
        <div class="customer-360-grid">
            ${risks.map(customer => `
                <div class="customer-360-card">
                    <div class="customer-360-header">
                        <b>${esc(customer.customer_id || customer.customer || "Unknown")}</b>
                    </div>
                    <div class="customer-360-row">
                        <span>Exposure</span>
                        <b>${money(customer.exposure ?? customer.outstanding_exposure ?? customer.outstanding_amount)}</b>
                    </div>
                    <div class="customer-360-row">
                        <span>Risk</span>
                        <b>${customer.risk_level || customer.risk || "—"}</b>
                    </div>
                    <div class="customer-360-row">
                        <span>Priority</span>
                        <b>${customer.priority || "REVIEW"}</b>
                    </div>
                </div>
            `).join("")}
        </div>`;
}

