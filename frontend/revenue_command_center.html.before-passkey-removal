<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>REVENEX — Revenue Command Center</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Inter,system-ui,-apple-system,sans-serif;background:#f4f7fb;color:#0f172a}
.app{display:flex;min-height:100vh}
.sidebar{width:240px;background:#0b1220;color:#fff;padding:24px 14px;position:fixed;inset:0 auto 0 0}
.logo{font-size:23px;font-weight:900;padding:0 10px}
.logo small{display:block;font-size:9px;color:#94a3b8;letter-spacing:.16em;margin-top:5px}
.nav{margin-top:28px}
.nav button{width:100%;border:0;background:none;color:#cbd5e1;text-align:left;padding:11px 12px;border-radius:8px;margin:2px 0;cursor:pointer;font-weight:600}
.nav button:hover,.nav button.active{background:#1e293b;color:#fff}
.main{margin-left:240px;width:calc(100% - 240px);padding:28px}
.top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:22px}
.eyebrow{font-size:11px;font-weight:800;color:#64748b;letter-spacing:.15em}
h1{margin:5px 0;font-size:30px}
.sub{color:#64748b}
.safety{background:#ecfdf3;color:#166534;border:1px solid #bbf7d0;padding:9px 13px;border-radius:999px;font-size:12px;font-weight:800}
.page{display:none}.page.active{display:block}
.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.card{background:white;border:1px solid #e5eaf1;border-radius:14px;padding:18px;box-shadow:0 1px 2px #00000008}
.label{font-size:11px;font-weight:800;color:#64748b}
.metric{font-size:27px;font-weight:900;margin-top:8px}
.risk{color:#dc2626}.good{color:#16a34a}
.layout{display:grid;grid-template-columns:1.7fr 1fr;gap:14px;margin-top:14px}
.title{font-size:16px;font-weight:900;margin-bottom:13px}
.row{display:flex;justify-content:space-between;padding:11px 0;border-bottom:1px solid #edf0f4}
.row:last-child{border-bottom:0}
textarea{width:100%;height:175px;border:1px solid #dbe1e8;border-radius:9px;padding:12px;font:12px monospace}
.actions{margin-top:10px;display:flex;gap:8px}
button.primary{background:#2563eb;color:#fff;border:0;border-radius:9px;padding:11px 16px;font-weight:800;cursor:pointer}
button.secondary{background:#eef2f7;color:#334155;border:0;border-radius:9px;padding:11px 16px;font-weight:800;cursor:pointer}
.status{margin-top:10px;color:#64748b;font-size:12px}
.pipeline{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.step{border:1px solid #e5eaf1;border-radius:9px;padding:12px;text-align:center;font-size:11px;font-weight:800}
.step b{display:block;font-size:17px;margin-bottom:4px}
.safetygrid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.safe{background:#f8fafc;border-radius:9px;padding:12px;font-size:12px}
.safe b{display:block;color:#16a34a;margin-top:4px}
table{width:100%;border-collapse:collapse}
th,td{text-align:left;padding:11px;border-bottom:1px solid #edf0f4;font-size:12px}
pre{white-space:pre-wrap;background:#f8fafc;border-radius:9px;padding:13px;font-size:11px}
.empty{text-align:center;color:#64748b;padding:30px}
@media(max-width:950px){.sidebar{width:190px}.main{margin-left:190px;width:calc(100% - 190px)}.metrics{grid-template-columns:1fr 1fr}.layout{grid-template-columns:1fr}}
@media(max-width:650px){.app{display:block}.sidebar{position:static;width:100%}.main{margin:0;width:100%;padding:15px}.metrics{grid-template-columns:1fr}.top{flex-direction:column;gap:12px}}
</style>

<style id="customer360-final-style">
.customer360-card {
  overflow: hidden;
}

.customer360-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20px;
  margin-bottom: 20px;
}

.customer360-subtitle {
  margin-top: 5px;
  font-size: 12px;
  opacity: .65;
}

.customer360-safety {
  font-size: 10px;
  letter-spacing: .07em;
  opacity: .7;
  white-space: nowrap;
}

.customer360-summary {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 20px;
}

.customer360-stat {
  padding: 14px;
  border: 1px solid rgba(128,128,128,.18);
  border-radius: 10px;
  background: rgba(128,128,128,.04);
}

.customer360-stat span {
  display: block;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: .06em;
  opacity: .6;
  margin-bottom: 7px;
}

.customer360-stat strong {
  font-size: 20px;
}

.customer360-table {
  width: 100%;
}

.customer360-table th,
.customer360-table td {
  padding: 13px 12px;
}

.customer360-table th {
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: .06em;
}

.customer360-note {
  margin-top: 15px;
  padding-top: 12px;
  border-top: 1px solid rgba(128,128,128,.15);
  font-size: 11px;
  opacity: .6;
}

@media (max-width: 800px) {
  .customer360-summary {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .customer360-heading {
    flex-direction: column;
  }

  .customer360-safety {
    white-space: normal;
  }
}
</style>


<style id="REVENEX_CUSTOMER360_ROW_GOVERNANCE_STYLE">

.revenex-customer-decision strong,
.revenex-customer-governance strong {
  font-size: 11px;
  letter-spacing: .02em;
}

.revenex-customer-decision {
  white-space: nowrap;
}

.revenex-customer-governance {
  white-space: nowrap;
}

.revenex-customer-governance small {
  display: block;
  margin-top: 4px;
  font-size: 9px;
  opacity: .55;
}

</style>


<style id="REVENEX_CUSTOMER360_DETAIL_STYLE">
.customer360-detail {
