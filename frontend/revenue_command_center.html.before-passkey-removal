<script>
/* REVENEX_CUSTOMER360_SUMMARY_WIRING */
(function () {
  function money(value) {
    return "₹" + Number(value || 0).toLocaleString("en-IN");
  }

  function updateCustomer360Summary() {
    const table = document.getElementById("customersTable");
    if (!table) return;

    const rows = Array.from(table.querySelectorAll("tr"))
      .filter(row => row.querySelectorAll("td").length >= 4);

    const customers = rows.map(row => {
      const cells = row.querySelectorAll("td");
      return {
        customer: cells[0]?.textContent?.trim() || "",
        exposureText: cells[1]?.textContent?.trim() || "",
        risk: cells[2]?.textContent?.trim()?.toUpperCase() || "",
        priority: cells[3]?.textContent?.trim()?.toUpperCase() || ""
      };
    }).filter(x => x.customer && !/run analysis/i.test(x.customer));

    let exposure = 0;

    customers.forEach(customer => {
      const raw = customer.exposureText
        .replace(/[₹,\s]/g, "")
        .replace(/[^\d.-]/g, "");

      const value = Number(raw);
      if (Number.isFinite(value)) exposure += value;
    });

    const highRisk = customers.filter(x =>
      /HIGH|CRITICAL|REVIEW/.test(x.risk)
    ).length;

    const priority = customers.filter(x =>
      /AI PRIORITY|PRIORITY/.test(x.priority)
    ).length;

    const count = document.getElementById("customer360Count");
    const total = document.getElementById("customer360Exposure");
    const risk = document.getElementById("customer360HighRisk");
    const ai = document.getElementById("customer360Priority");

    if (count) count.textContent = customers.length;
    if (total) total.textContent = money(exposure);
    if (risk) risk.textContent = highRisk;
    if (ai) ai.textContent = priority;
  }

  window.updateCustomer360Summary = updateCustomer360Summary;

  const observer = new MutationObserver(function () {
    updateCustomer360Summary();
  });

  function init() {
    const table = document.getElementById("customersTable");
    if (!table) return;

    observer.observe(table, {
      childList: true,
      subtree: true,
      characterData: true
    });

    updateCustomer360Summary();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
</script>


<script>
/* REVENEX_CUSTOMER360_ROW_GOVERNANCE */
(function () {

  function enhanceCustomerRows() {
    const table = document.getElementById("customersTable");
    if (!table) return;

    const rows = Array.from(table.querySelectorAll("tr"));

    rows.forEach(function (row) {
      const cells = row.querySelectorAll("td");

      /*
       * Existing renderer provides:
       * Customer | Exposure | Risk | Priority
       *
       * We add:
       * Decision | Governance
       */

      if (cells.length < 4) return;

      if (row.dataset.revenexGovernance === "true") return;

      const customer = cells[0].textContent.trim();

      if (!customer || /run analysis/i.test(customer)) return;

      const risk = cells[2].textContent.trim().toUpperCase();

      const decision = document.createElement("td");
      decision.className = "revenex-customer-decision";

      if (/HIGH|CRITICAL|REVIEW/.test(risk)) {
        decision.innerHTML =
          '<strong>RECOVERY REVIEW</strong>';
      } else {
        decision.innerHTML =
          '<span>MONITOR</span>';
      }

      const governance = document.createElement("td");
      governance.className = "revenex-customer-governance";

      governance.innerHTML =
        '<strong>APPROVAL REQUIRED</strong>' +
        '<small>Execution disabled</small>';

      row.appendChild(decision);
      row.appendChild(governance);

      row.dataset.revenexGovernance = "true";
    });
  }

  function initCustomerGovernance() {
    const table = document.getElementById("customersTable");
    if (!table) return;

    enhanceCustomerRows();

    const observer = new MutationObserver(function () {
      enhanceCustomerRows();
    });

    observer.observe(table, {
      childList: true,
      subtree: true,
      characterData: true
    });

    window.revenexEnhanceCustomerRows = enhanceCustomerRows;
  }

  if (document.readyState === "loading") {
    document.addEventListener(
      "DOMContentLoaded",
      initCustomerGovernance
    );
  } else {
    initCustomerGovernance();
  }

})();
</script>





<script>
(function () {

  function money(value) {
    const n = Number(String(value || "")
      .replace(/[₹,\s]/g, "")
      .replace(/[^\d.-]/g, ""));

    return Number.isFinite(n)
      ? "₹" + n.toLocaleString("en-IN")
      : "₹0";
  }

  function openCustomer(row) {

    const cells = row.querySelectorAll("td");

    if (cells.length < 3) return;

    const customer = cells[0].textContent.trim();

    if (!customer || /run analysis/i.test(customer)) {
      return;
    }

    const exposure = cells[1].textContent.trim();
    const risk = cells[2].textContent.trim();
    const priority = cells[3]
      ? cells[3].textContent.trim()
      : "AI PRIORITY";

    const panel = document.getElementById("customer360Detail");

    if (!panel) {
      console.error("[REVENEX] Customer 360 detail panel missing");
      return;
    }

    document.getElementById("c360DetailCustomer").textContent = customer;

    document.getElementById("c360DetailExposure").textContent =
      money(exposure);

    document.getElementById("c360DetailRisk").textContent =
      risk || "REVIEW";

    document.getElementById("c360DetailPriority").textContent =
      priority || "AI PRIORITY";

    document.getElementById("c360DetailDecision").textContent =
      "RECOVERY REVIEW";

    document.getElementById("c360DetailGovernance").textContent =
      "APPROVAL REQUIRED";

    document.getElementById("c360DetailReason").textContent =
      "REVENEX identified this customer as a review priority based on the available revenue exposure and risk signal. The recommendation is advisory-only and requires human approval.";

    panel.style.display = "block";

    panel.scrollIntoView({
      behavior: "smooth",
      block: "nearest"
    });
  }

  function wireCustomerRows() {

    const table = document.getElementById("customersTable");

    if (!table) return;

    table.querySelectorAll("tr").forEach(function (row) {

      const cells = row.querySelectorAll("td");

      if (cells.length < 3) return;

      const customer = cells[0].textContent.trim();

      if (!customer || /run analysis/i.test(customer)) return;

      if (row.dataset.revenexCustomer360 === "true") return;

      row.dataset.revenexCustomer360 = "true";

      row.style.cursor = "pointer";

      row.addEventListener("click", function () {
        openCustomer(row);
      });

    });
  }

  function initCustomer360() {

    const table = document.getElementById("customersTable");

    if (!table) {
      console.warn("[REVENEX] customersTable not ready");
      return;
    }

    wireCustomerRows();

    const observer = new MutationObserver(function () {
      wireCustomerRows();
    });

    observer.observe(table, {
      childList: true,
      subtree: true,
      characterData: true
    });

    console.log("[REVENEX] Customer 360 intelligence ready");
  }

  if (document.readyState === "loading") {
    document.addEventListener(
      "DOMContentLoaded",
      initCustomer360
    );
  } else {
    initCustomer360();
  }

})();
</script>








<script id="REVENEX_LOGIN_SCRIPT_V1">
(function(){
