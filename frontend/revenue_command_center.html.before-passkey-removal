@media (max-width:800px) {
  .customer360-detail-grid {
    grid-template-columns:repeat(2,minmax(0,1fr));
  }
}
</style>


<style id="REVENEX_WOW_DESIGN_V1">
/* =========================================================
   REVENEX — WOW ENTERPRISE FINTECH DESIGN SYSTEM
   Visual-only layer. Existing IDs/API/JS preserved.
   ========================================================= */

:root{
  --rx-bg:#070b12;
  --rx-panel:#0d131d;
  --rx-panel-2:#111925;
  --rx-panel-3:#151e2b;
  --rx-border:rgba(255,255,255,.075);
  --rx-border-strong:rgba(255,255,255,.13);
  --rx-text:#f4f7fb;
  --rx-muted:#8995a7;
  --rx-soft:#b7c0ce;
  --rx-green:#36e0a0;
  --rx-blue:#63a8ff;
  --rx-purple:#9b8cff;
  --rx-red:#ff6577;
  --rx-yellow:#f5c76b;
  --rx-shadow:0 18px 55px rgba(0,0,0,.28);
  --rx-radius:18px;
}

*{box-sizing:border-box}

html{
  background:var(--rx-bg)!important;
  scroll-behavior:smooth;
}

body{
  margin:0!important;
  min-height:100vh;
  background:
    radial-gradient(circle at 78% -10%,rgba(99,168,255,.12),transparent 30%),
    radial-gradient(circle at 10% 20%,rgba(155,140,255,.07),transparent 28%),
    linear-gradient(180deg,#070b12 0%,#090e16 48%,#070b12 100%)!important;
  color:var(--rx-text)!important;
  font-family:Inter,-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text",Segoe UI,sans-serif!important;
  letter-spacing:-.01em;
}

/* ---------- scrollbar ---------- */
::-webkit-scrollbar{width:9px;height:9px}
::-webkit-scrollbar-track{background:#080c13}
::-webkit-scrollbar-thumb{
  background:#263243;
  border-radius:99px;
  border:2px solid #080c13;
}
::-webkit-scrollbar-thumb:hover{background:#34445b}

/* ---------- navigation ---------- */
nav,aside,.sidebar,[class*="sidebar"],[class*="nav"]{
  border-color:var(--rx-border)!important;
}

button{
  font-family:inherit!important;
  transition:all .2s ease!important;
}

button:hover{
  transform:translateY(-1px);
}

/* ---------- page ---------- */
.page{
  animation:rxPageIn .35s ease both;
}

@keyframes rxPageIn{
  from{opacity:0;transform:translateY(7px)}
  to{opacity:1;transform:none}
}

/* ---------- cards ---------- */
.card{
  position:relative!important;
  overflow:hidden!important;
  background:
    linear-gradient(145deg,rgba(21,30,43,.94),rgba(10,15,23,.96))!important;
  border:1px solid var(--rx-border)!important;
  border-radius:var(--rx-radius)!important;
  box-shadow:var(--rx-shadow)!important;
  backdrop-filter:blur(18px);
  -webkit-backdrop-filter:blur(18px);
  transition:
    border-color .22s ease,
    transform .22s ease,
    box-shadow .22s ease!important;
}

.card:hover{
  border-color:var(--rx-border-strong)!important;
  box-shadow:0 22px 65px rgba(0,0,0,.34)!important;
}

.card:before{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;
  background:linear-gradient(
    135deg,
    rgba(255,255,255,.035),
    transparent 35%
  );
}

/* ---------- headings ---------- */
.title{
  color:var(--rx-text)!important;
  font-weight:700!important;
  font-size:16px!important;
  letter-spacing:-.025em!important;
}

.label,.eyebrow{
  color:var(--rx-muted)!important;
  font-weight:700!important;
  letter-spacing:.1em!important;
  font-size:10px!important;
}

.sub{
  color:var(--rx-soft)!important;
  line-height:1.65!important;
}

.metric{
  color:var(--rx-text)!important;
  font-weight:750!important;
  letter-spacing:-.045em!important;
  font-variant-numeric:tabular-nums;
}

.metric.good,.good{color:var(--rx-green)!important}
.metric.risk,.risk{color:var(--rx-red)!important}

/* ---------- KPI grids ---------- */
.card .metric{
  text-shadow:0 0 28px rgba(255,255,255,.07);
}

#risk,#iRisk,#fRisk,#simulationRisk,
#expected,#iRecovery,#decisionCollection,
#simulationExpected,#learningExpected{
  font-size:clamp(27px,3vw,42px)!important;
}

#outstanding,#iExposure,#fRemaining,
#decisionRemaining,#simulationRemaining,
#iRemainingExposure,#simulationRemainingDetail{
  font-size:clamp(25px,2.7vw,38px)!important;
}

/* ---------- rows ---------- */
.row{
  min-height:42px;
  border-bottom:1px solid rgba(255,255,255,.055)!important;
  color:var(--rx-soft)!important;
  gap:18px;
}

.row:last-child{border-bottom:0!important}

.row span{
  color:var(--rx-muted)!important;
}

.row b{
  color:var(--rx-text)!important;
  font-weight:650!important;
  font-variant-numeric:tabular-nums;
}

/* ---------- safety ---------- */
.safetygrid{
  gap:10px!important;
}

.safe{
  position:relative;
  background:rgba(255,255,255,.025)!important;
  border:1px solid rgba(54,224,160,.12)!important;
  border-radius:13px!important;
  color:var(--rx-muted)!important;
  transition:all .2s ease;
}

.safe:hover{
  background:rgba(54,224,160,.045)!important;
  border-color:rgba(54,224,160,.25)!important;
}

.safe b{
  color:var(--rx-green)!important;
  letter-spacing:.06em;
  font-size:11px;
}

/* ---------- tables ---------- */
table{
  border-collapse:separate!important;
  border-spacing:0!important;
  overflow:hidden;
  border:1px solid var(--rx-border)!important;
  border-radius:14px!important;
  background:rgba(255,255,255,.012)!important;
}

th{
  background:rgba(255,255,255,.035)!important;
  color:#8794a7!important;
  text-transform:uppercase;
  letter-spacing:.08em;
  font-size:10px!important;
  font-weight:750!important;
}

td{
  color:#d8dee8!important;
  border-color:rgba(255,255,255,.055)!important;
  font-variant-numeric:tabular-nums;
}

tbody tr{
  transition:background .18s ease;
}

tbody tr:hover{
  background:rgba(99,168,255,.045)!important;
}

/* ---------- Customer 360 ---------- */
.customer360-card,
.customer-360-card{
  background:
    linear-gradient(145deg,#111a27,#0b111a)!important;
}

.customer360-stat{
  background:rgba(255,255,255,.025)!important;
  border:1px solid var(--rx-border)!important;
  border-radius:14px!important;
  transition:.2s ease;
}

.customer360-stat:hover{
  border-color:rgba(99,168,255,.25)!important;
  transform:translateY(-2px);
}

.customer360-stat strong{
  color:var(--rx-text)!important;
  font-variant-numeric:tabular-nums;
}

/* ---------- status pills ---------- */
[class*="status"],[class*="badge"],[class*="pill"]{
  border-radius:999px!important;
}

/* ---------- code / analysis blocks ---------- */
pre,code{
  font-family:"SFMono-Regular",Menlo,Monaco,Consolas,monospace!important;
}

pre{
  background:#060a10!important;
  border:1px solid var(--rx-border)!important;
  border-radius:14px!important;
}

/* ---------- links ---------- */
a{
  color:var(--rx-blue);
  text-decoration:none;
}

/* ---------- inputs ---------- */
input,textarea,select{
  background:#080e17!important;
  color:var(--rx-text)!important;
  border:1px solid var(--rx-border-strong)!important;
  border-radius:11px!important;
  outline:none!important;
}

input:focus,textarea:focus,select:focus{
  border-color:rgba(99,168,255,.55)!important;
  box-shadow:0 0 0 3px rgba(99,168,255,.08)!important;
}

/* ---------- primary actions ---------- */
button:not([data-page]){
  border-radius:11px!important;
  border:1px solid rgba(99,168,255,.25)!important;
  background:linear-gradient(135deg,#1a3658,#10243d)!important;
  color:#eaf3ff!important;
  font-weight:650!important;
  box-shadow:0 8px 25px rgba(0,0,0,.2)!important;
}

button:not([data-page]):hover{
  border-color:rgba(99,168,255,.55)!important;
  box-shadow:0 10px 30px rgba(36,115,190,.16)!important;
}

/* ---------- nav buttons ---------- */
button[data-page]{
  border:1px solid transparent!important;
  background:transparent!important;
  color:#8995a7!important;
  border-radius:11px!important;
  font-weight:600!important;
}

button[data-page]:hover{
  background:rgba(255,255,255,.045)!important;
  color:#eef4fc!important;
}

button[data-page].active,
button[data-page][aria-current="page"]{
  background:
    linear-gradient(135deg,rgba(99,168,255,.14),rgba(155,140,255,.08))
    !important;
  border-color:rgba(99,168,255,.18)!important;
  color:#fff!important;
  box-shadow:inset 3px 0 0 #63a8ff!important;
}

/* ---------- pipeline ---------- */
[class*="pipeline"]{
  position:relative;
}

[class*="pipeline"] > *{
  transition:.2s ease;
}

/* ---------- intelligence accent ---------- */
#intelligence .card:first-child,
#command .card:first-child{
  background:
    radial-gradient(circle at 90% 0%,rgba(99,168,255,.13),transparent 32%),
    linear-gradient(145deg,#111b29,#0a1018)!important;
}

/* ---------- decision accent ---------- */
#decisions .card{
  background:
    radial-gradient(circle at 100% 0%,rgba(155,140,255,.08),transparent 35%),
    linear-gradient(145deg,#111927,#0b111a)!important;
}

/* ---------- forecast accent ---------- */
#forecast .card{
  background:
    radial-gradient(circle at 100% 0%,rgba(99,168,255,.07),transparent 34%),
    linear-gradient(145deg,#111927,#0b111a)!important;
}

/* ---------- simulation accent ---------- */
#simulation .card{
  background:
    radial-gradient(circle at 100% 0%,rgba(54,224,160,.055),transparent 34%),
    linear-gradient(145deg,#111927,#0b111a)!important;
}

/* ---------- audit ---------- */
#audit .card{
  background:
    linear-gradient(145deg,#101823,#0a1018)!important;
}

/* ---------- learning ---------- */
#learning .card{
  background:
    radial-gradient(circle at 100% 0%,rgba(155,140,255,.065),transparent 35%),
    linear-gradient(145deg,#111927,#0b111a)!important;
}

/* ---------- empty states ---------- */
.empty{
  color:#6f7b8d!important;
  border-color:var(--rx-border)!important;
}

/* ---------- focus ---------- */
:focus-visible{
  outline:2px solid rgba(99,168,255,.55)!important;
  outline-offset:2px;
}

/* ---------- mobile ---------- */
@media(max-width:900px){
  .card{
    border-radius:15px!important;
  }

  .metric{
    letter-spacing:-.035em!important;
  }

  table{
    font-size:12px;
  }
}

@media(max-width:600px){
  .card{
    padding:15px!important;
  }

  .row{
    min-height:38px;
  }

  table{
    display:block;
    overflow-x:auto;
  }
}

/* ---------- premium glow ---------- */
#risk,#iRisk,#fRisk{
  text-shadow:0 0 35px rgba(255,101,119,.12);
}

#expected,#iRecovery,#simulationExpected{
  text-shadow:0 0 35px rgba(54,224,160,.12);
}

/* ---------- top-level visual polish ---------- */
section{
  scroll-margin-top:25px;
}

hr{
  border:0!important;
  border-top:1px solid var(--rx-border)!important;
}

strong,b{
  font-variant-numeric:tabular-nums;
}

/* ---------- governance emphasis ---------- */
.safe b,
[id*="approval"],
[id*="Approval"]{
  letter-spacing:.045em;
}

/* ---------- subtle glass highlight ---------- */
.card > *{
  position:relative;
  z-index:1;
}
</style>


<style id="REVENEX_LOGIN_SCREEN_V1">
