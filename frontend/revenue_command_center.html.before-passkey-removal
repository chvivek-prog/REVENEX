<style>
#rxPasskeyActions{
  display:grid;
  gap:10px;
  margin-top:12px;
}
.rx-passkey-btn{
  width:100%;
  border:1px solid rgba(120,180,255,.28);
  background:linear-gradient(135deg,#2563eb,#7c3aed);
  color:white;
  border-radius:12px;
  padding:13px 16px;
  font-weight:800;
  cursor:pointer;
  box-shadow:0 12px 32px rgba(37,99,235,.22);
}
.rx-passkey-btn.secondary{
  background:rgba(255,255,255,.06);
  box-shadow:none;
}
#rxPasskeyStatus{
  font-size:12px;
  opacity:.78;
  margin-top:8px;
}
</style>
<script id="REVENEX_REAL_PASSKEY_SCRIPT_V1">
(function(){
  const API = "/api/v1/auth/passkey";
  const email = document.getElementById("rxLoginEmail");
  const form = document.getElementById("revenexLoginForm");
  const login = document.getElementById("revenexLogin");

  if(!email || !login) return;

  const passwordInput = document.getElementById("rxLoginPassword");
  const submit = form ? form.querySelector('button[type="submit"]') : null;

  const actions = document.createElement("div");
  actions.id = "rxPasskeyActions";
  actions.innerHTML = `
    <button type="button" class="rx-passkey-btn" id="rxPasskeyLogin">
      Continue with Passkey
    </button>
    <button type="button" class="rx-passkey-btn secondary" id="rxPasskeyRegister">
      
    </button>
    <div id="rxPasskeyStatus"></div>
  `;

  if(form) form.appendChild(actions);

  const status = document.getElementById("rxPasskeyStatus");

  function b64ToBytes(value){
    const pad = "=".repeat((4 - value.length % 4) % 4);
    const raw = atob(value.replace(/-/g,"+").replace(/_/g,"/") + pad);
    return Uint8Array.from(raw, c => c.charCodeAt(0));
  }

  function bytesToB64(bytes){
    let s="";
    for(const b of new Uint8Array(bytes)) s += String.fromCharCode(b);
    return btoa(s).replace(/\+/g,"-").replace(/\//g,"_").replace(/=+$/,"");
  }

  function registrationJSON(cred){
    return {
      id: cred.id,
      rawId: bytesToB64(cred.rawId),
      type: cred.type,
      response: {
        clientDataJSON: bytesToB64(cred.response.clientDataJSON),
        attestationObject: bytesToB64(cred.response.attestationObject)
      },
      clientExtensionResults: cred.getClientExtensionResults()
    };
  }

  function authenticationJSON(cred){
    return {
      id: cred.id,
      rawId: bytesToB64(cred.rawId),
      type: cred.type,
      response: {
        clientDataJSON: bytesToB64(cred.response.clientDataJSON),
        authenticatorData: bytesToB64(cred.response.authenticatorData),
        signature: bytesToB64(cred.response.signature),
        userHandle: cred.response.userHandle
          ? bytesToB64(cred.response.userHandle)
          : null
      },
      clientExtensionResults: cred.getClientExtensionResults()
    };
  }

  async function json(url, body){
    const r = await fetch(url, {
      method:"POST",
      credentials:"include",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify(body)
    });
    const data = await r.json();
    if(!r.ok) throw new Error(data.message || data.error || "Authentication failed");
    return data;
  }

  function requireEmail(){
    const value = email.value.trim().toLowerCase();
    if(!value) throw new Error("Enter your workspace email first.");
    return value;
  }

  async function register(){
    if(!window.PublicKeyCredential)
      throw new Error("This browser does not support Passkeys.");

    const userEmail = requireEmail();

    status.textContent = "Preparing secure  registration…";

    const start = await json(API + "/register/options", {
      email:userEmail
    });

    const opts = start.options;
    opts.challenge = b64ToBytes(opts.challenge);
    opts.user.id = b64ToBytes(opts.user.id);

    if(opts.excludeCredentials){
      opts.excludeCredentials = opts.excludeCredentials.map(c => ({
        ...c,
        id:b64ToBytes(c.id)
      }));
    }

    status.textContent = "Approve  on your device…";

    const credential = await navigator.credentials.create({
      publicKey:opts
    });

    const result = await json(API + "/register/verify", {
      email:userEmail,
      challenge_id:start.challenge_id,
      credential:registrationJSON(credential)
    });

    status.textContent = "✓ Passkey registered. You can now sign in with .";

    if(passwordInput) passwordInput.value = "";
    sessionStorage.setItem("revenex_authenticated","true");

    const loginButton = document.getElementById("rxPasskeyLogin");
    if(loginButton) loginButton.textContent = "Continue with ";

    if(typeof window.revenexEnterDashboard === "function"){
      window.revenexEnterDashboard();
    } else {
      login.style.display = "none";
    }
  }

  async function loginPasskey(){
    if(!window.PublicKeyCredential)
      throw new Error("This browser does not support Passkeys.");

    const userEmail = requireEmail();

    status.textContent = "Preparing secure authentication…";

    const start = await json(API + "/login/options", {
      email:userEmail
    });

    const opts = start.options;
    opts.challenge = b64ToBytes(opts.challenge);

    if(opts.allowCredentials){
      opts.allowCredentials = opts.allowCredentials.map(c => ({
        ...c,
        id:b64ToBytes(c.id)
      }));
    }

    status.textContent = "Approve  on your device…";

    const credential = await navigator.credentials.get({
      publicKey:opts
    });

    await json(API + "/login/verify", {
      email:userEmail,
      challenge_id:start.challenge_id,
      credential:authenticationJSON(credential)
    });

    sessionStorage.setItem("revenex_authenticated","true");
    status.textContent = "✓ Authenticated with Passkey.";

    if(typeof window.revenexEnterDashboard === "function"){
      window.revenexEnterDashboard();
    } else {
      login.style.display = "none";
    }
  }

  document.getElementById("rxPasskeyRegister")
    ?.addEventListener("click", async () => {
      try { await register(); }
      catch(e){ status.textContent = "⚠ " + e.message; }
    });

  document.getElementById("rxPasskeyLogin")
    ?.addEventListener("click", async () => {
      try { await loginPasskey(); }
      catch(e){ status.textContent = "⚠ " + e.message; }
    });
})();
</script>

