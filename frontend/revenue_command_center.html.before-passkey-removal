  const form = document.getElementById("revenexLoginForm");
  const demo = document.getElementById("rxDemoLogin");
  const error = document.getElementById("rxLoginError");
  const email = document.getElementById("rxLoginEmail");
  const password = document.getElementById("rxLoginPassword");

  if(!login || !form) return;

  function enterDashboard(){
    login.style.transition = "opacity .35s ease, transform .35s ease";
    login.style.opacity = "0";
    login.style.transform = "scale(1.015)";
    setTimeout(() => {
      login.style.display = "none";
    }, 360);
  }

  form.addEventListener("submit", function(e){
    e.preventDefault();

    if(!email.value.trim() || !password.value.trim()){
      error.style.display = "block";
      return;
    }

    error.style.display = "none";
    sessionStorage.setItem("revenex_authenticated","true");
    enterDashboard();
  });

  demo.addEventListener("click", function(){
    email.value = "demo@revenex.ai";
    password.value = "demo";
    error.style.display = "none";
    sessionStorage.setItem("revenex_authenticated","true");
    enterDashboard();
  });

  if(sessionStorage.getItem("revenex_authenticated") === "true"){
    login.style.display = "none";
  }
})();
</script>


